[Unit]
Description=Türstation: Ansagen und Töne
Wants=network-online.target user@@UID@.service
After=network-online.target mosquitto.service user@@UID@.service doorstation-baresip.service
StartLimitIntervalSec=0

[Service]
User=doorstation
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
ExecStart=/opt/doorstation/venv/sound/bin/doorstation-sound --config /etc/doorstation/sound.yaml
Restart=always
RestartSec=2
# Exit 2 = Konfigurationsfehler: nicht alle 2 s neu starten (bleibt stehen, Status offline)
RestartPreventExitStatus=2

# Härtung – geprüft mit common/tests/test_systemd_units.py und systemd-analyze security
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
DevicePolicy=closed
# PipeWire-Socket des Benutzerdienstes liegt unter /run/user (ProtectHome=yes würde ihn verbergen)
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
