[Unit]
Description=Door station: announcements and sounds
Wants=network-online.target user@@UID@.service
After=network-online.target mosquitto.service user@@UID@.service doorstation-baresip.service
StartLimitIntervalSec=0

[Service]
User=doorstation
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
ExecStart=/opt/doorstation/venv/sound/bin/doorstation-sound --config /etc/doorstation/sound.yaml
Restart=always
RestartSec=2
# Exit 2 = configuration error: do not restart every 2 s (stays stopped, status offline)
RestartPreventExitStatus=2

# Hardening - checked by common/tests/test_systemd_units.py and systemd-analyze security
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
DevicePolicy=closed
# The PipeWire socket of the user service lives in /run/user (ProtectHome=yes would hide it)
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
