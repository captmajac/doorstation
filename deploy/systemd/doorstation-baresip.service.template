[Unit]
Description=Door station: baresip (SIP phone)
Wants=network-online.target user@@UID@.service
After=network-online.target mosquitto.service user@@UID@.service

# Never give up for good (e.g. USB stick late at boot): otherwise no bell.
StartLimitIntervalSec=0

[Service]
User=doorstation
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
ExecStartPre=/opt/doorstation/venv/sip/bin/doorstation-audio-init
ExecStart=/usr/bin/baresip -f /var/lib/doorstation/baresip
Restart=always
RestartSec=2

# Hardening - checked by common/tests/test_systemd_units.py and systemd-analyze security
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
DevicePolicy=closed
# The PipeWire socket of the user service lives in /run/user (ProtectHome=yes would hide it)
ProtectHome=read-only
# AF_NETLINK: baresip looks up interfaces and addresses
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# amixer in doorstation-audio-init
DeviceAllow=char-alsa rw

[Install]
WantedBy=multi-user.target
