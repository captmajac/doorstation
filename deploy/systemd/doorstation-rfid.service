[Unit]
Description=Door station: RFID/Home Key reader (PN532)
Wants=network-online.target
After=network-online.target mosquitto.service
# Never give up for good (e.g. reader unplugged briefly).
StartLimitIntervalSec=0

[Service]
User=doorstation
ExecStart=/opt/doorstation/venv/rfid/bin/doorstation-rfid --config /etc/doorstation/rfid.yaml
Restart=always
RestartSec=2
# Exit 2 = configuration error: do not restart every 2 s (stays stopped, status offline)
RestartPreventExitStatus=2

# Hardening - checked by common/tests/test_systemd_units.py and systemd-analyze security
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
DevicePolicy=closed
ProtectHome=yes
RestrictRealtime=yes
# AF_NETLINK: zeroconf (HomeKit) reads the network interfaces
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# PN532 on the UART (nfc_path tty:AMA0); state_dir must be here
DeviceAllow=char-ttyAMA rw
ReadWritePaths=/var/lib/doorstation/rfid

[Install]
WantedBy=multi-user.target
