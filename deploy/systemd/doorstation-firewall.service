[Unit]
Description=Türstation: Paketfilter (SIP/RTP nur von der FritzBox)
# Wie nftables.service früh laden, aber danach (dessen "flush ruleset" würde die Tabelle löschen).
DefaultDependencies=no
Wants=network-pre.target
After=nftables.service
Before=network-pre.target shutdown.target doorstation-baresip.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /opt/doorstation/firewall.nft
ExecStop=/usr/sbin/nft delete table inet doorstation

[Install]
WantedBy=sysinit.target
