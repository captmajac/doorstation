[Unit]
Description=Door station: packet filter (SIP/RTP from the FritzBox only)
# Load early like nftables.service, but after it (its "flush ruleset" would delete the table).
DefaultDependencies=no
Wants=network-pre.target
After=nftables.service
Before=network-pre.target shutdown.target doorstation-baresip.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /opt/doorstation/firewall.nft
ExecStop=/usr/sbin/nft delete table inet doorstation

[Install]
WantedBy=sysinit.target
