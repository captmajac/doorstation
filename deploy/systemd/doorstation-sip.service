[Unit]
Description=Türstation: SIP-Adapter (Klingel → Anruf, Befehle, DTMF)
Wants=network-online.target
After=network-online.target mosquitto.service doorstation-baresip.service

# Nie endgültig aufgeben (z. B. USB-Stick beim Booten spät): sonst keine Klingel mehr.
StartLimitIntervalSec=0

[Service]
User=doorstation
ExecStart=/opt/doorstation/venv/sip/bin/doorstation-sip --config /etc/doorstation/sip.yaml
Restart=always
RestartSec=2
# Exit 2 = Konfigurationsfehler: nicht alle 2 s neu starten (bleibt stehen, Status offline)
RestartPreventExitStatus=2

# Härtung – geprüft mit common/tests/test_systemd_units.py und systemd-analyze security
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
DevicePolicy=closed
ProtectHome=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/doorstation/sip

[Install]
WantedBy=multi-user.target
