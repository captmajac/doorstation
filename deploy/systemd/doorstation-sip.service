[Unit]
Description=Door station: SIP adapter (bell -> call, commands, DTMF)
Wants=network-online.target
After=network-online.target mosquitto.service doorstation-baresip.service

# Never give up for good (e.g. USB stick late at boot): otherwise no bell.
StartLimitIntervalSec=0

[Service]
User=doorstation
ExecStart=/opt/doorstation/venv/sip/bin/doorstation-sip --config /etc/doorstation/sip.yaml
Restart=always
RestartSec=2
# Exit 2 = configuration error: do not restart every 2 s (stays stopped, status offline)
RestartPreventExitStatus=2

# Hardening - checked by common/tests/test_systemd_units.py and systemd-analyze security
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
DevicePolicy=closed
ProtectHome=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/doorstation/sip

[Install]
WantedBy=multi-user.target
