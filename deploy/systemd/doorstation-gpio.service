[Unit]
Description=Door station: GPIO inputs (bell, motion, mailbox)
Wants=network-online.target
After=network-online.target mosquitto.service
# Never give up for good: otherwise the bell stays silent.
StartLimitIntervalSec=0

[Service]
User=doorstation
ExecStart=/opt/doorstation/venv/gpio/bin/doorstation-gpio --config /etc/doorstation/gpio.yaml
Restart=always
RestartSec=2
# Exit 2 = configuration error: do not restart every 2 s (stays stopped, status offline)
RestartPreventExitStatus=2

# Hardening - checked by common/tests/test_systemd_units.py and systemd-analyze security
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
DevicePolicy=closed
ProtectHome=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DeviceAllow=char-gpiochip rw

[Install]
WantedBy=multi-user.target
