# Door station bridge to the home automation - generated by install.sh from /etc/doorstation/bridge.yaml
connection ips
address @HOST@:@PORT@
remote_username @USERNAME@
remote_password @PASSWORD@
remote_clientid doorstation-bridge
cleansession false
try_private false
# No "@PREFIX@/# out 1": overlapping rules would buffer rfid/read with QoS 1 and
# deliver it late. Hence one rule per area. Events that must not arrive late after an
# outage (bell, RFID, DTMF "#" = door opener) use QoS 0 only.
# Checked by common/tests/test_bridge_template.py.
topic @PREFIX@/event/# out 0
topic @PREFIX@/gpio/# out 1
topic @PREFIX@/sip/status out 1
topic @PREFIX@/sip/error out 1
topic @PREFIX@/sip/call out 1
topic @PREFIX@/sip/target out 1
topic @PREFIX@/sip/registration out 1
topic @PREFIX@/sip/dtmf out 0
topic @PREFIX@/sound/# out 1
topic @PREFIX@/rfid/status out 1
topic @PREFIX@/rfid/pairing out 1
topic @PREFIX@/rfid/error out 1
topic @PREFIX@/rfid/read out 0
# Commands with QoS 0: the home automation's broker does not buffer them during an
# outage and does not deliver them late.
topic @PREFIX@/+/cmd in 0
