# Packet filter of the door station - generated by install.sh from /etc/doorstation/sip.yaml.
# Accept SIP (5060/5061, UDP and TCP) and RTP of baresip from the FritzBox only: direct
# calls from the LAN (even with a spoofed sender) never reach baresip.
# All other ports (SSH, HomeKit, mDNS ...) are left alone.
table inet doorstation
delete table inet doorstation

table inet doorstation {
	set sip_ports {
		type inet_service
		flags interval
		elements = { 5060-5061, @RTP_PORTS@ }
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;
		iif "lo" accept
		ip saddr @FRITZBOX@ meta l4proto { udp, tcp } th dport @sip_ports accept
		meta l4proto { udp, tcp } th dport @sip_ports counter drop
	}
}
